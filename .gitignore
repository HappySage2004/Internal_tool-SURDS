# ─── Python / FastAPI backend ───────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ─── Node / React (Vite) frontend ───────────────────────────
node_modules/
internal_tool-ui/dist/
internal_tool-ui/.vite/
*.local

# ─── Environment & secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem

# ─── App data (interim JSON DB & uploads) ───────────────────
# Local JSON "database" — runtime data, regenerated by the first-run
# seeder (CLAUDE.md §8). Not tracked in git.
internal_tool-backend/local_DB/*.json
# Uploaded markdown / PDF / image bytes
internal_tool-backend/uploads/
uploads/

# ─── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Editor / OS cruft ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
