# Storage backend: "mongo" (default) reads/writes MongoDB; "json" uses local_DB/*.json.
STORAGE_BACKEND=mongo

# MongoDB (used when STORAGE_BACKEND=mongo).
# For Atlas use the SRV connection string, e.g.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=Cluster0
# Keep the real credentialed URI in .env (git-ignored), never here.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Internal_tool_DEV

# JSON fallback (used only when STORAGE_BACKEND=json).
LOCAL_DB_PATH=local_DB

SECRET_KEY=changeme-generate-a-real-secret

# First-time setup: python scripts/DB_init_SCRIPT.py   (creates collections + seeds users)
# Import existing local_DB/*.json into Mongo: python scripts/migrate_json_to_mongo.py
