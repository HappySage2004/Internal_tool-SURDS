# MongoDB is the only storage backend.
# For Atlas use the SRV connection string, e.g.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=Cluster0
# Keep the real credentialed URI in .env (git-ignored), never here.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Internal_tool_DEV

SECRET_KEY=changeme-generate-a-real-secret

# First-time setup: python scripts/DB_init_SCRIPT.py   (creates collections + seeds users)
